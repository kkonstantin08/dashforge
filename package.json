{
  "name": "dashforge",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve",
    "build": "ng build --configuration production",
    "test": "ng test --watch=false",
    "preview": "http-server dist/dashforge/browser -a 127.0.0.1 -p 4173 -c-1 --silent",
    "lint": "eslint src e2e playwright.config.ts",
    "format:check": "prettier --check src e2e *.ts *.json *.mjs .github/workflows",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test:unit": "ng test --watch=false",
    "test:e2e": "playwright test"
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.8",
    "@angular/cli": "^22.2.8",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "angular-eslint": "22.8.0",
    "eslint": "10.15.0",
    "http-server": "14.1.1",
    "jsdom": "^30.0.0",
    "prettier": "3.10.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.73.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^24.15.0"
  }
}
